// Using declarations and namespace aliases in Lotus
// Demonstrates different ways to import namespaced items

use "io";

namespace math {
    fn int add(int a, int b) {
        ret a + b;
    }

    fn int subtract(int a, int b) {
        ret a - b;
    }

    fn int multiply(int a, int b) {
        ret a * b;
    }
}

namespace utils {
    namespace string {
        fn int length(string s) {
            int len = 0;
            while s[len] != '\0' {
                len = len + 1;
            }
            ret len;
        }

        fn string concat(string a, string b) {
            // Simplified concatenation
            ret a + b;
        }
    }

    namespace array {
        template<typename T>
        fn void print_array(T* arr, int len) {
            for int i = 0; i < len; i = i + 1 {
                io::printf("%v ", arr[i]);
            }
            io::println("");
        }
    }
}

fn void test_qualified_names() {
    io::println("=== Using Qualified Names ===");

    // Fully qualified names
    int result = math::add(10, 5);
    io::println("math::add(10, 5) = %d", result);

    int len = utils::string::length("hello");
    io::println("utils::string::length('hello') = %d", len);
}

fn void test_using_specific() {
    io::println("\n=== Using Specific Items ===");

    // Import specific function
    using math::add;

    // Now we can use 'add' without qualification
    int sum = add(20, 30);
    io::println("add(20, 30) = %d", sum);

    // Other math functions still need qualification
    int product = math::multiply(4, 5);
    io::println("math::multiply(4, 5) = %d", product);
}

fn void test_using_namespace() {
    io::println("\n=== Using Namespace ===");

    // Import entire namespace
    using namespace math;

    // All math functions available without qualification
    int a = add(5, 3);
    int b = subtract(10, 4);
    int c = multiply(6, 7);

    io::println("add(5, 3) = %d", a);
    io::println("subtract(10, 4) = %d", b);
    io::println("multiply(6, 7) = %d", c);
}

fn void test_namespace_alias() {
    io::println("\n=== Namespace Aliases ===");

    // Create alias for nested namespace
    namespace str = utils::string;

    // Use alias instead of full path
    int len = str::length("Lotus");
    io::println("str::length('Lotus') = %d", len);

    string combined = str::concat("Hello", " World");
    io::println("str::concat result: %s", combined);
}

fn void test_using_with_alias() {
    io::println("\n=== Using With Alias ===");

    // Import with custom name
    using math::multiply as mul;

    // Use custom name
    int result = mul(8, 9);
    io::println("mul(8, 9) = %d", result);
}

fn void test_template_in_namespace() {
    io::println("\n=== Template in Namespace ===");

    using namespace utils::array;

    int[5] numbers = {1, 2, 3, 4, 5};
    io::printf("Array: ");
    print_array<int>(numbers, 5);

    float[3] floats = {1.1, 2.2, 3.3};
    io::printf("Floats: ");
    print_array<float>(floats, 3);
}

fn int main() {
    test_qualified_names();
    test_using_specific();
    test_using_namespace();
    test_namespace_alias();
    test_using_with_alias();
    test_template_in_namespace();

    ret 0;
}
